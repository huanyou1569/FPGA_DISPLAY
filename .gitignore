# Keep authored RTL, BD, XDC, XPR, C/H, Tcl/Python scripts, docs,
# IP component.xml, simulation .wcfg and binary model assets in Git.

# Vivado / MCP runtime and generated products
.Xil/
.vivado-ai/
.ipcfg/
/*.cache/
/*.gen/
/*.hw/
/*.ip_user_files/
/*.runs/
/*.sim/
# Keep .srcs/ and its .bd/.xci IP configuration files: they are project inputs.
/*.srcs/**/ipshared/
*.bda
*.xpr.lock
*.jou
*.log
*.str
*.wdb
*.pb
*.rst
*.rpt
*.rpx
*.vdi
*.vds
*.wdf
